@@ -1,3 +1,15 @@
+import type { Book, ImportBookOptions } from '@/types/book';
+import type { ClosableFile } from '@/utils/file';
+import { partialMD5 } from '@/utils/md5';
+
+export function transientImportOptions(): ImportBookOptions {
+  const online = typeof window !== 'undefined' && window.__MOKE_EMBEDDED &&
+    !!window.__MOKE_SOURCE_SERVER_URL;
+  // The embedded online reader has no library cover grid. The cover inside
+  // the EPUB is still rendered normally; do not download it twice on open.
+  return online ? { transient: true, saveCover: false } : { transient: true };
+}
+
 export async function runTransientReaderBootstrap(
   openFiles: () => Promise<void>,
   onFailure: (error: unknown) => void,
@@ -9,3 +21,19 @@ export async function runTransientReaderBootstrap(
     onFailure(error);
   }
 }
+
+export async function precheckManagedBookHash(
+  file: string,
+  library: Book[],
+  openFile: (path: string) => Promise<File>,
+): Promise<string | undefined> {
+  // Import still computes the original hash. This pass only protects managed
+  // entries from being rewritten by a transient import, so skip an empty set.
+  if (!library.some((book) => !book.deletedAt)) return undefined;
+  const opened = await openFile(file);
+  try {
+    return await partialMD5(opened);
+  } finally {
+    await (opened as Partial<ClosableFile>).close?.();
+  }
+}
