index 0000000..cbd6b76
--- /dev/null
+++ b/apps/readest-app/src/__tests__/services/remoteFileCache.test.ts
@@ -0,0 +1,124 @@
+import { describe, expect, it, vi } from 'vitest';
+vi.mock('@/utils/misc', () => ({ getOSPlatform: () => 'linux' }));
+vi.mock('@/services/environment', () => ({ isTauriAppPlatform: () => false }));
+import { RemoteFile } from '@/utils/file';
+
+const BLOCK = 16 * 1024;
+async function fixture(size = BLOCK * 24 + 7) {
+  const bytes = Uint8Array.from({ length: size }, (_, i) => i % 251);
+  const ranges: [number, number][] = [];
+  const transport = {
+    maxCacheChunkSize: BLOCK,
+    maxCoalescedRangeSize: BLOCK * 8,
+    fetch: vi.fn(async (_url: string, init?: RequestInit) => {
+      if (init?.method === 'HEAD') {
+        return new Response(null, { headers: { 'content-length': String(size) } });
+      }
+      const [, first, last] = new Headers(init?.headers).get('range')!.match(/bytes=(\d+)-(\d+)/)!;
+      const start = Number(first),
+        end = Number(last);
+      expect(end).toBeLessThan(size);
+      ranges.push([start, end]);
+      return new Response(bytes.slice(start, end + 1), { status: 206 });
+    }),
+  };
+  const file = await new RemoteFile(
+    'https://books.example/book.epub',
+    'book.epub',
+    '',
+    0,
+    transport,
+  ).open();
+  return { file, bytes, ranges, transport };
+}
+
+describe('online aligned Range cache', () => {
+  it('merges different concurrent slices and returns exact cross-block bytes', async () => {
+    const { file, bytes, ranges } = await fixture();
+    const [first, second] = await Promise.all([
+      file.slice(123, BLOCK * 3 + 400).arrayBuffer(),
+      file.slice(BLOCK - 5, BLOCK * 4).arrayBuffer(),
+    ]);
+    expect(new Uint8Array(first)).toEqual(bytes.slice(123, BLOCK * 3 + 400));
+    expect(new Uint8Array(second)).toEqual(bytes.slice(BLOCK - 5, BLOCK * 4));
+    expect(ranges).toEqual([[0, BLOCK * 8 - 1]]);
+    await file.slice(10, BLOCK * 6).arrayBuffer();
+    expect(ranges).toHaveLength(1);
+  });
+
+  it('keeps distant partial-hash probes small and deduplicates adjacent probes', async () => {
+    const { file, ranges } = await fixture();
+    await Promise.all([
+      file.slice(0, 1024).arrayBuffer(),
+      file.slice(1024, 2048).arrayBuffer(),
+      file.slice(BLOCK * 20, BLOCK * 20 + 1024).arrayBuffer(),
+    ]);
+    expect(ranges).toEqual([
+      [0, BLOCK - 1],
+      [BLOCK * 20, BLOCK * 21 - 1],
+    ]);
+  });
+
+  it('does not refetch cached probe blocks when coalescing larger reads', async () => {
+    const { file, bytes, ranges } = await fixture();
+    await file.slice(BLOCK * 3, BLOCK * 3 + 3).arrayBuffer();
+    expect(new Uint8Array(await file.slice(0, BLOCK * 9).arrayBuffer())).toEqual(
+      bytes.slice(0, BLOCK * 9),
+    );
+    for (let i = 0; i < ranges.length; i++)
+      for (let j = i + 1; j < ranges.length; j++) {
+        expect(ranges[i]![1] < ranges[j]![0] || ranges[j]![1] < ranges[i]![0]).toBe(true);
+      }
+  });
+
+  it('clamps EOF, handles empty slices, and includes the byte after a cached boundary', async () => {
+    const { file, bytes } = await fixture();
+    await file.slice(0, 1024).arrayBuffer();
+    expect(new Uint8Array(await file.slice(BLOCK - 1, BLOCK + 1).arrayBuffer())).toEqual(
+      bytes.slice(BLOCK - 1, BLOCK + 1),
+    );
+    expect(
+      new Uint8Array(await file.slice(bytes.length - 10, bytes.length + 100).arrayBuffer()),
+    ).toEqual(bytes.slice(-10));
+    expect((await file.slice(bytes.length, bytes.length).arrayBuffer()).byteLength).toBe(0);
+  });
+
+  it('does not cache failures and retries without poisoned in-flight blocks', async () => {
+    const { file, transport, bytes } = await fixture();
+    transport.fetch.mockRejectedValueOnce(new Error('network'));
+    await expect(file.slice(0, BLOCK * 3).arrayBuffer()).rejects.toThrow('network');
+    expect(new Uint8Array(await file.slice(0, BLOCK * 3).arrayBuffer())).toEqual(
+      bytes.slice(0, BLOCK * 3),
+    );
+  });
+
+  it('does not repopulate caches after close or delete a reopened pending request', async () => {
+    const { file, transport, bytes } = await fixture();
+    let resolve!: (r: Response) => void;
+    transport.fetch.mockImplementationOnce(
+      () =>
+        new Promise((r) => {
+          resolve = r;
+        }),
+    );
+    const old = file.slice(0, 1024).arrayBuffer();
+    const rejected = expect(old).rejects.toThrow('Remote file closed');
+    await file.close();
+    await file.open();
+    const current = file.slice(0, 1024).arrayBuffer();
+    resolve(new Response(bytes.slice(0, BLOCK), { status: 206 }));
+    await rejected;
+    expect(new Uint8Array(await current)).toEqual(bytes.slice(0, 1024));
+  });
+
+  it('evicts least-recently-used blocks beyond the 16 MiB per-file limit', async () => {
+    const { file, ranges } = await fixture(17 * 1024 * 1024);
+    for (let offset = 0; offset < 17 * 1024 * 1024; offset += BLOCK * 8) {
+      await file.slice(offset, offset + BLOCK * 8).arrayBuffer();
+    }
+    const count = ranges.length;
+    await file.slice(0, 1).arrayBuffer();
+    expect(ranges).toHaveLength(count + 1);
+    expect(ranges.at(-1)).toEqual([0, BLOCK - 1]);
+  });
+});
