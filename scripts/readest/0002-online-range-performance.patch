@@ -0,0 +1,40 @@
+import { afterEach, describe, expect, it, vi } from 'vitest';
+vi.mock('@/utils/md5', () => ({ partialMD5: vi.fn(async () => 'original-hash') }));
+import { partialMD5 } from '@/utils/md5';
+import type { Book } from '@/types/book';
+import { precheckManagedBookHash, transientImportOptions } from '@/app/reader/utils/transientReader';
+
+afterEach(() => { window.__MOKE_EMBEDDED = false; window.__MOKE_SOURCE_SERVER_URL = null; });
+
+it('skips library-cover downloads only for embedded online imports', () => {
+  expect(transientImportOptions()).toEqual({ transient: true });
+  window.__MOKE_EMBEDDED = true;
+  expect(transientImportOptions()).toEqual({ transient: true });
+  window.__MOKE_SOURCE_SERVER_URL = 'https://books.example';
+  expect(transientImportOptions()).toEqual({ transient: true, saveCover: false });
+  window.__MOKE_EMBEDDED = false;
+  expect(transientImportOptions()).toEqual({ transient: true });
+});
+
+describe('managed-book hash precheck', () => {
+  it.each([{ library: [] }, { library: [{ deletedAt: 1 }] }])('skips file I/O when there are no managed books: %j', async ({ library }) => {
+    const open = vi.fn();
+    expect(await precheckManagedBookHash('book.epub', library as Book[], open)).toBeUndefined();
+    expect(open).not.toHaveBeenCalled();
+  });
+  it('preserves the original hash and closes the file when managed books exist', async () => {
+    const close = vi.fn();
+    const file = Object.assign(new File(['book'], 'book.epub'), { close });
+    const open = vi.fn(async () => file);
+    expect(await precheckManagedBookHash('book.epub', [{}] as Book[], open)).toBe('original-hash');
+    expect(open).toHaveBeenCalledWith('book.epub');
+    expect(close).toHaveBeenCalledOnce();
+  });
+  it('closes a managed precheck file on hashing failure', async () => {
+    vi.mocked(partialMD5).mockRejectedValueOnce(new Error('hash failed'));
+    const close = vi.fn();
+    await expect(precheckManagedBookHash('book.epub', [{}] as Book[], async () =>
+      Object.assign(new File([], 'book.epub'), { close }))).rejects.toThrow('hash failed');
+    expect(close).toHaveBeenCalledOnce();
+  });
+});
