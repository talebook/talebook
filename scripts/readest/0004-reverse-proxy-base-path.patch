diff --git a/apps/readest-app/src/__tests__/services/remoteSourceBasePath.test.ts b/apps/readest-app/src/__tests__/services/remoteSourceBasePath.test.ts
new file mode 100644
--- /dev/null
+++ b/apps/readest-app/src/__tests__/services/remoteSourceBasePath.test.ts
@@ -0,0 +1,27 @@
+import { describe, expect, it } from 'vitest';
+import { validateMokeRemoteSource } from '@/services/mokeRemoteSource';
+
+describe('remote EPUB source base path', () => {
+  it('accepts an exact resource under the server base path', () => {
+    const url = 'https://example.test/team/books/read/resource/2.epub?revision=v1';
+    expect(validateMokeRemoteSource(url, 'https://example.test/team/books/', '2').url).toBe(url);
+  });
+  it.each([
+    'https://example.test/team/../books',
+    'https://example.test/team%2Fbooks',
+    'https://example.test/team/books?x=1',
+    'https://example.test//team/books',
+    'https://example.test/team/books#x',
+  ])('rejects ambiguous server base %s', (server) => {
+    expect(() => validateMokeRemoteSource('https://example.test/team/books/read/resource/2.epub?revision=v1', server, '2')).toThrow();
+  });
+  it.each([
+    'https://example.test/read/resource/2.epub?revision=v1',
+    'https://example.test/team/books-evil/read/resource/2.epub?revision=v1',
+    'https://other.test/team/books/read/resource/2.epub?revision=v1',
+    'https://example.test/team/books/read/resource/3.epub?revision=v1',
+    'https://example.test/team/books/read/resource/2.epub?revision=v1&other=1',
+  ])('rejects resources outside the exact delegation %s', (url) => {
+    expect(() => validateMokeRemoteSource(url, 'https://example.test/team/books', '2')).toThrow();
+  });
+});
