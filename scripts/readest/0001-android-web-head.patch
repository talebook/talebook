diff --git a/apps/readest-app/src/__tests__/services/remoteFilePlatform.test.ts b/apps/readest-app/src/__tests__/services/remoteFilePlatform.test.ts
new file mode 100644
index 0000000..fd866d8
--- /dev/null
+++ b/apps/readest-app/src/__tests__/services/remoteFilePlatform.test.ts
@@ -0,0 +1,57 @@
+import { afterEach, describe, expect, it, vi } from 'vitest';
+
+const platform = vi.hoisted(() => ({ os: 'android', native: false }));
+vi.mock('@/utils/misc', () => ({ getOSPlatform: () => platform.os }));
+vi.mock('@/services/environment', () => ({ isTauriAppPlatform: () => platform.native }));
+import { RemoteFile } from '@/utils/file';
+import { createMokeRemoteSourceTransport } from '@/services/mokeRemoteSource';
+
+afterEach(() => {
+  vi.restoreAllMocks();
+  window.__MOKE_EMBEDDED = false;
+  window.__MOKE_SOURCE_SERVER_URL = null;
+  window.__MOKE_BOOK_ID = null;
+});
+
+describe('RemoteFile platform-specific metadata probe (TB-204)', () => {
+  it.each([
+    ['android', false, 'head'],
+    ['android', true, 'range'],
+    ['linux', false, 'head'],
+    ['linux', true, 'head'],
+  ])('%s native=%s uses %s', async (os, native, expected) => {
+    platform.os = os as string;
+    platform.native = native as boolean;
+    const file = new RemoteFile('https://books.example/book.epub');
+    const head = vi.spyOn(file, '_open_with_head').mockResolvedValue(file);
+    const range = vi.spyOn(file, '_open_with_range').mockResolvedValue(file);
+    await file.open();
+    expect(head).toHaveBeenCalledTimes(expected === 'head' ? 1 : 0);
+    expect(range).toHaveBeenCalledTimes(expected === 'range' ? 1 : 0);
+  });
+
+  it('initializes the strict source transport before Android browser range reads', async () => {
+    platform.os = 'android';
+    platform.native = false;
+    const source = 'https://books.example/read/resource/10.epub?revision=v1';
+    window.__MOKE_EMBEDDED = true;
+    window.__MOKE_SOURCE_SERVER_URL = 'https://books.example';
+    window.__MOKE_BOOK_ID = '10';
+    const fetchImpl = vi.fn(async (_url: string, init?: RequestInit) => {
+      const head = init?.method === 'HEAD';
+      const result = new Response(head ? null : new Uint8Array(2048), {
+        status: head ? 200 : 206,
+        headers: { 'Content-Type': 'application/epub+zip', 'Content-Length': '2048',
+          'Accept-Ranges': 'bytes', ETag: '"v1"', ...(head ? {} : {'Content-Range': 'bytes 0-2047/2048'}) },
+      });
+      Object.defineProperty(result, 'url', {value: source});
+      return result;
+    });
+    const file = new RemoteFile(source, 'book.epub', '', 0, createMokeRemoteSourceTransport(source, fetchImpl)!);
+    await file.open();
+    expect(file.size).toBe(2048);
+    expect((await file.slice(0, 4).arrayBuffer()).byteLength).toBe(4);
+    expect(fetchImpl.mock.calls.map(([, init]) => init?.method)).toEqual(['HEAD', 'GET']);
+    await file.close();
+  });
+});
