+import { beforeEach, describe, expect, it, vi } from 'vitest';
+const env = vi.hoisted(() => ({ native: false }));
+vi.mock('@/services/environment', () => ({
+  isTauriAppPlatform: () => env.native,
+  getAPIBaseUrl: () => 'https://web.readest.com/api',
+}));
+vi.mock('@/utils/misc', () => ({ getUserLang: () => 'en', makeSafeFilename: (s: string) => s }));
+vi.mock('@tauri-apps/plugin-http', () => ({ fetch: vi.fn() }));
+import { fetch as nativeFetch } from '@tauri-apps/plugin-http';
+import { KOSyncClient } from '@/services/sync/KOSyncClient';
+import { KOSyncSettings } from '@/types/settings';
+
+const config = (serverUrl = 'https://sync.example'): KOSyncSettings => ({
+  serverUrl, username: 'alice', password: 'password', userkey: 'hash', enabled: true,
+  deviceName: 'test', deviceId: 'test-id', strategy: 'prompt', checksumMethod: 'binary',
+} as KOSyncSettings);
+const envelope = (status = 200, data: object = { authorized: 'OK' }) =>
+  new Response(JSON.stringify({ err: 'ok', status, data }));
+
+describe('Talebook KOSync client routing', () => {
+  beforeEach(() => {
+    env.native = false;
+    vi.clearAllMocks();
+    window.history.replaceState({}, '', '/readest/reader.html?moke=1&mokeSourceServerUrl=' + encodeURIComponent(location.origin));
+    vi.stubGlobal('fetch', vi.fn().mockResolvedValue(envelope()));
+  });
+
+  it.each(['https://sync.example', 'http://192.168.1.9:8080/kosync'])('uses Talebook for %s without a Readest account', async url => {
+    expect((await new KOSyncClient(config(url)).connect('alice', 'password')).success).toBe(true);
+    const [target, options] = vi.mocked(fetch).mock.calls[0]!;
+    expect(target).toBe('/api/kosync');
+    expect(JSON.parse(options!.body as string)).toMatchObject({
+      serverUrl: url, endpoint: '/users/auth', method: 'GET',
+      headers: { 'x-auth-user': 'alice', 'x-auth-key': 'hash' },
+    });
+    expect(options!.credentials).toBe('same-origin');
+  });
+
+  it.each([400, 401])('keeps Basic Auth retry working for HTTP %i', async status => {
+    vi.mocked(fetch).mockResolvedValueOnce(envelope(status, { message: 'KOSync authentication failed' })).mockResolvedValueOnce(envelope());
+    expect((await new KOSyncClient(config()).connect('alice', 'password')).success).toBe(true);
+    expect(JSON.parse(vi.mocked(fetch).mock.calls[1]![1]!.body as string).headers.authorization).toMatch(/^Basic /);
+  });
+
+  it('stops after one failed Basic Auth retry', async () => {
+    vi.mocked(fetch).mockImplementation(async () => envelope(401, { message: 'KOSync authentication failed' }));
+    expect((await new KOSyncClient(config())['request']('/users/auth')).status).toBe(401);
+    expect(fetch).toHaveBeenCalledTimes(2);
+  });
+
+  it('keeps native hosts on the native direct connection', async () => {
+    env.native = true;
+    vi.mocked(nativeFetch).mockResolvedValueOnce(new Response('{"authorized":"OK"}'));
+    expect((await new KOSyncClient(config()).connect('alice', 'password')).success).toBe(true);
+    expect(nativeFetch).toHaveBeenCalledWith('https://sync.example/users/auth', expect.any(Object));
+    expect(fetch).not.toHaveBeenCalled();
+  });
+
+  it('keeps standalone Readest on its existing proxy', async () => {
+    window.history.replaceState({}, '', '/readest/reader.html');
+    vi.mocked(fetch).mockResolvedValueOnce(new Response('{"authorized":"OK"}'));
+    expect((await new KOSyncClient(config()).connect('alice', 'password')).success).toBe(true);
+    expect(vi.mocked(fetch).mock.calls[0]![0]).toBe('https://web.readest.com/api/kosync');
+  });
+});
