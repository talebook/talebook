diff --git a/apps/readest-app/src/services/nav/progressive.ts b/apps/readest-app/src/services/nav/progressive.ts
new file mode 100644
index 0000000..b0d156d
--- /dev/null
+++ b/apps/readest-app/src/services/nav/progressive.ts
@@ -0,0 +1,72 @@
+import type { BookDoc, TOCItem } from '@/libs/document';
+import { computeBookNav, type BookNav } from './index';
+import { needsTocEnrichment } from './enrichment';
+import { cloneTocItems, collectAllTocItems, groupTocSubitems } from './grouping';
+import { bakeLocationsAndCfis } from './locations';
+
+// Sparse TOCs and sorted TOCs need the complete index before presentation.
+// Fixed layout and native/local reading retain the original initialization.
+export function canDeferBookNav(book: BookDoc, online: boolean, sorted: boolean): boolean {
+  return online && !sorted && book.rendition?.layout !== 'pre-paginated' &&
+    !!book.toc?.length && !needsTocEnrichment(book);
+}
+
+export function prepareProgressiveNav(book: BookDoc) {
+  book.toc = cloneTocItems(book.toc ?? []);
+  groupTocSubitems(book, book.toc);
+  bakeLocationsAndCfis(book.toc, book.sections, (href) => book.splitTOCHref(href));
+  return cloneTocItems(book.toc);
+}
+
+export async function completeProgressiveNav(
+  book: BookDoc, signal: AbortSignal, originalToc: TOCItem[],
+): Promise<BookNav | null> {
+  if (signal.aborted) return null;
+  // computeBookNav writes fragments to its sections. Isolate those writes until
+  // the whole result is ready, preserving the currently readable document.
+  const scratch = Object.assign(Object.create(Object.getPrototypeOf(book)), book, {
+    // Persist original labels, never the per-open Chinese conversion.
+    toc: cloneTocItems(originalToc),
+    sections: book.sections.map((section) => ({ ...section })),
+  }) as BookDoc;
+  const nav = await computeBookNav(scratch, { background: true, signal });
+  if (signal.aborted) return null;
+  const completed = collectAllTocItems(nav.toc);
+  const live = collectAllTocItems(book.toc ?? []);
+  // This path never enriches/reorders the TOC. Refuse an unexpected structural
+  // result rather than invalidating Foliate's private TOCProgress references.
+  if (live.length !== completed.length || live.some((item, i) => item.href !== completed[i]?.href)) {
+    throw new Error('Progressive navigation changed TOC structure');
+  }
+  for (const section of book.sections) section.fragments = nav.sections[section.id]?.fragments;
+  live.forEach((item, i) => {
+    item.cfi = completed[i]!.cfi;
+    item.location = completed[i]!.location;
+  });
+  // Rebuild memoized sidebar rows while retaining TOCProgress's item references.
+  book.toc = [...(book.toc ?? [])];
+  // Keep live IDs, labels, hrefs, object identities and renderer position intact.
+  return nav;
+}
+
+export function deferredNavTask(run: (signal: AbortSignal) => Promise<void>) {
+  const controller = new AbortController();
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  let started = false;
+  return {
+    start() {
+      if (started || controller.signal.aborted) return;
+      started = true;
+      // Triggered by first relocate. Give the browser time to paint the page.
+      timer = setTimeout(() => {
+        void run(controller.signal).catch((error) => {
+          if (!controller.signal.aborted) console.warn('Optional navigation indexing failed:', error);
+        });
+      }, 100);
+    },
+    cancel() {
+      controller.abort();
+      clearTimeout(timer);
+    },
+  };
+}
