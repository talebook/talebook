+import { afterEach, describe, expect, it, vi } from 'vitest';
+import type { BookDoc } from '@/libs/document';
+import { canDeferBookNav, prepareProgressiveNav, completeProgressiveNav, deferredNavTask } from '@/services/nav/progressive';
+
+vi.mock('@/utils/simplecc', () => ({ initSimpleCC: vi.fn(), runSimpleCC: (s: string) => s }));
+vi.mock('@/libs/document', () => ({ CFI: {
+  fromElements: () => ['/4/2'], joinIndir: (a: string, b: string) => a + b,
+} }));
+
+function fixture(count = 3) {
+  const html = '<html><body><h1 id="chapter">Chapter</h1><p>Text</p></body></html>';
+  const sections = Array.from({ length: count }, (_, i) => ({
+    id: `s${i}`, cfi: `epubcfi(/6/${2 * i + 2})`, size: 3000,
+    loadText: vi.fn(async () => html),
+    createDocument: vi.fn(async () => new DOMParser().parseFromString(html, 'text/html')),
+  }));
+  const book = { metadata: {}, rendition: {}, sections,
+    toc: sections.map((s) => ({ href: `${s.id}#chapter`, label: s.id })),
+    splitTOCHref: (href: string) => href.split('#'),
+  } as unknown as BookDoc;
+  return { book, sections };
+}
+
+afterEach(() => vi.useRealTimers());
+
+describe('progressive navigation', () => {
+  it('prepares usable hrefs and total positions without reading any chapter', () => {
+    const { book, sections } = fixture();
+    prepareProgressiveNav(book);
+    expect(book.toc![1]!.href).toBe('s1#chapter');
+    expect(book.toc![1]!.location?.total).toBeGreaterThan(0);
+    for (const s of sections) {
+      expect(s.loadText).not.toHaveBeenCalled();
+      expect(s.createDocument).not.toHaveBeenCalled();
+    }
+  });
+
+  it('fills precise anchors without replacing live objects, IDs, labels or sizes', async () => {
+    const { book, sections } = fixture();
+    const original = prepareProgressiveNav(book);
+    const toc = book.toc!;
+    const item = toc[1]!;
+    item.id = 42;
+    item.label = 'converted label';
+    const nav = await completeProgressiveNav(book, new AbortController().signal, original);
+    expect(book.toc).not.toBe(toc);
+    expect(book.toc![1]).toBe(item);
+    expect(item.id).toBe(42);
+    expect(item.label).toBe('converted label');
+    expect(item.cfi).toContain('/4/2');
+    expect(nav!.toc[1]!.label).toBe('s1');
+    expect(sections.map((s) => s.size)).toEqual([3000, 3000, 3000]);
+    expect(book.sections[1]!.fragments).toHaveLength(1);
+  });
+
+  it('does not mutate the visible index until all work completes; abort discards it', async () => {
+    const { book, sections } = fixture();
+    const original = prepareProgressiveNav(book);
+    let finish!: (text: string) => void;
+    sections[0]!.loadText.mockImplementation(() => new Promise((r) => { finish = r; }));
+    const controller = new AbortController();
+    const pending = completeProgressiveNav(book, controller.signal, original);
+    await vi.waitFor(() => expect(finish).toBeDefined());
+    expect(book.sections[0]!.fragments).toBeUndefined();
+    controller.abort();
+    finish('done');
+    expect(await pending).toBeNull();
+    expect(book.sections[0]!.fragments).toBeUndefined();
+  });
+
+  it('keeps sparse, sorted, fixed-layout and non-online books on the complete path', () => {
+    const { book } = fixture(100);
+    expect(canDeferBookNav(book, true, false)).toBe(true);
+    expect(canDeferBookNav(book, false, false)).toBe(false);
+    expect(canDeferBookNav(book, true, true)).toBe(false);
+    book.rendition = { layout: 'pre-paginated' } as never;
+    expect(canDeferBookNav(book, true, false)).toBe(false);
+    book.rendition = {} as never;
+    book.toc = book.toc!.slice(0, 1);
+    expect(canDeferBookNav(book, true, false)).toBe(false);
+  });
+
+  it('limits background reads to two and stops queued reads after close', async () => {
+    const { book, sections } = fixture(10);
+    const original = prepareProgressiveNav(book);
+    const releases: Array<(s: string) => void> = [];
+    sections.forEach(s => s.loadText.mockImplementation(() => new Promise(r => releases.push(r))));
+    const controller = new AbortController();
+    const pending = completeProgressiveNav(book, controller.signal, original);
+    await vi.waitFor(() => expect(releases).toHaveLength(2));
+    expect(sections[2]!.loadText).not.toHaveBeenCalled();
+    controller.abort();
+    releases.forEach(release => release('content'));
+    expect(await pending).toBeNull();
+    expect(sections[2]!.loadText).not.toHaveBeenCalled();
+  });
+
+  it('does not apply or cache a partially failed background index', async () => {
+    const { book, sections } = fixture();
+    const original = prepareProgressiveNav(book);
+    sections[1]!.createDocument.mockRejectedValue(new Error('network unavailable'));
+    await expect(completeProgressiveNav(book, new AbortController().signal, original)).rejects.toThrow('network unavailable');
+    expect(book.sections.every(s => !s.fragments)).toBe(true);
+  });
+
+  it('waits for first progress and a paint opportunity, runs once, and cancels pending work', async () => {
+    vi.useFakeTimers();
+    const run = vi.fn(async (_signal: AbortSignal) => {});
+    const task = deferredNavTask(run);
+    await vi.advanceTimersByTimeAsync(1000);
+    expect(run).not.toHaveBeenCalled();
+    task.start(); task.start();
+    await vi.advanceTimersByTimeAsync(99);
+    expect(run).not.toHaveBeenCalled();
+    await vi.advanceTimersByTimeAsync(1);
+    expect(run).toHaveBeenCalledOnce();
+    task.cancel();
+    expect(run.mock.calls[0]![0].aborted).toBe(true);
+    const other = deferredNavTask(run);
+    other.start(); other.cancel();
+    await vi.runAllTimersAsync();
+    expect(run).toHaveBeenCalledOnce();
+  });
+
+  it('contains optional failure instead of rejecting the reader open', async () => {
+    vi.useFakeTimers();
+    const warning = vi.spyOn(console, 'warn').mockImplementation(() => {});
+    const task = deferredNavTask(async () => { throw new Error('unavailable'); });
+    task.start();
+    await vi.runAllTimersAsync();
+    expect(warning).toHaveBeenCalledOnce();
+    warning.mockRestore();
+  });
+});
